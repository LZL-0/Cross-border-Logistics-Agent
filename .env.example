# 复制为 .env 后填写真实值，.env 不要提交到版本库

# ---------- 模型（OpenAI 兼容接口，可选） ----------
# 留空则全部走 classic 规则兜底，离线也能完整演示
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------- 约束层 ----------
# plan（写操作需 confirm）/ auto / readonly
AGENT_PERMISSION_MODE=plan
# allowlist（按域名白名单）/ block（禁网）；本项目离线运行，无外网工具
TOOL_NET_POLICY=allowlist
TOOL_NET_ALLOWLIST=
# 工具可写路径根，留空默认项目根；多个用系统路径分隔符
TOOL_PATH_ROOTS=

# ---------- 预算 ----------
MAX_TOOL_CALLS=12
REACT_MAX_ROUNDS=4
CONTEXT_CHAR_BUDGET=6000

# ---------- 业务基线 ----------
# 旺季月份，用于附加费与清关延误叠加
PEAK_MONTHS=9,10,11,12
