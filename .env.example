# 复制为 .env 后填写真实值，.env 不要提交到版本库

# ---------- 模型（OpenAI 兼容接口，DeepSeek / 通义等） ----------
# 留空则全部走 classic 规则兜底，离线也能完整演示
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ---------- 实时信息 ----------
# 总开关：0 关闭后 realtime.* 工具直接报不可用，回到纯离线基线
REALTIME_ENABLED=1
# 检索入口（360 结果页，免 Key；Bing 作兜底）
SEARCH_BASE_URL=https://www.so.com/s
SEARCH_FALLBACK_URL=https://cn.bing.com/search
SEARCH_ENGINE=news,so,bing
SEARCH_NEWS_URL=https://news.so.com/ns
# 汇率入口（open.er-api.com，日更，免 Key）
FX_BASE_URL=https://open.er-api.com/v6/latest
# 上海航运交易所 SCFI 运价指数页
SCFI_URL=https://www.sse.net.cn/index/singleIndex?indexType=scfi
REALTIME_TIMEOUT=15
REALTIME_CACHE_TTL=180
REALTIME_MAX_RESULTS=5
FETCH_MAX_CHARS=3000

# ---------- 约束层 ----------
# plan（写操作需 confirm）/ auto / readonly
AGENT_PERMISSION_MODE=plan
# allowlist（按域名白名单）/ block（禁网）
TOOL_NET_POLICY=allowlist
# * 表示允许任意公网域名（realtime 模块内部仍做内网/回环拦截）；
# 收紧时改成具体域名，如：*.bing.com,open.er-api.com
TOOL_NET_ALLOWLIST=*
# 工具可写路径根，留空默认项目根；多个用系统路径分隔符
TOOL_PATH_ROOTS=

# ---------- 预算 ----------
MAX_TOOL_CALLS=100
REACT_MAX_ROUNDS=6
CONTEXT_CHAR_BUDGET=6000

# ---------- 业务基线 ----------
# 旺季月份，用于附加费与清关延误叠加
PEAK_MONTHS=9,10,11,12

# ---------- 知识库周更 ----------
# 每周自动生成候选更新（行情 + 口岸时效），不自动改表；确认后走 /api/kb/apply
KB_SYNC_ENABLED=1
KB_SYNC_WEEKDAY=4
KB_SYNC_HOUR=18
